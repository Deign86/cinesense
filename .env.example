# Example environment variables for CineSense
# Create a `.env` file from this template for local development.

# OMDB API Key (get a free key at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Django settings
DEBUG=True
# Comma-separated list (no spaces required) e.g.:
# ALLOWED_HOSTS=cinesense-seven.vercel.app,.vercel.app,localhost,127.0.0.1
ALLOWED_HOSTS=cinesense-seven.vercel.app,.vercel.app,localhost,127.0.0.1
