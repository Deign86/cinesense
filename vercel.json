{
  "version": 2,
  "build": {
    "command": "python manage.py migrate --noinput && python manage.py seed_movies"
  },
  "builds": [
    {
      "src": "cinesense_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["staticfiles/**", "db.sqlite3"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/cinesense_project/wsgi.py" }
  ],
  "env": {
    "ALLOWED_HOSTS": "cinesense-seven.vercel.app,.vercel.app,localhost,127.0.0.1",
    "DEBUG": "False"
  }
}
