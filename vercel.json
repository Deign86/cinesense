{
  "version": 2,
  "builds": [
    { "src": "cinesense_project/wsgi.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/cinesense_project/wsgi.py" }
  ],
  "env": {
    "ALLOWED_HOSTS": "cinesense-seven.vercel.app,.vercel.app,localhost,127.0.0.1",
    "DEBUG": "False"
  }
}
